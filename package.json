{
  "name": "abyssal-whispers",
  "version": "0.9.6",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:legacy": "python build.py --dev",
    "build": "vite build",
    "build:single": "python build.py",
    "build:legacy": "python build.py",
    "build:legacy:dev": "python build.py --dev",
    "verify": "npm test && npm run build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "node tests/run_all.cjs",
    "test:smoke": "node tests/test_smoke_flows.cjs",
    "test:data": "node tests/test_game_data_protocol.cjs",
    "test:effects": "node tests/test_effect_protocol.cjs",
    "test:integration": "node tests/integration_test.cjs",
    "test:reinc": "node tests/test_reincarnation_core.cjs",
    "test:reinc:sim": "node tests/test_reincarnation_player_sim.cjs --verbose --loops 8 --personality balanced",
    "simulate:loops": "node scripts/simulate_loops.cjs",
    "test:missing600": "node src/data/test_missing_600.js",
    "lint:events": "node src/data/lint_extended_events.js",
    "lint:narrative": "node scripts/lint-narrative-quality.mjs",
    "lint:narrative:verbose": "node scripts/lint-narrative-quality.mjs --verbose",
    "lint:npc": "node scripts/lint-npc-consistency.mjs",
    "lint:npc:verbose": "node scripts/lint-npc-consistency.mjs --verbose",
    "lint:npc:strict": "node scripts/lint-npc-consistency.mjs --strict",
    "lint:san": "node scripts/lint_san_mutations.cjs",
    "lint:engine": "node scripts/lint-engine-boundary.cjs",
    "lint:schema": "node scripts/validate-data.cjs",
    "lint:schema:verbose": "node scripts/validate-data.cjs --verbose",
    "mod:validate": "node scripts/mod_validate.cjs",
    "mod:preview": "node scripts/mod_preview.cjs",
    "mod:pack": "node scripts/mod_pack.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "node scripts/benchmark/runBenchmarks.cjs",
    "benchmark:reducer": "node scripts/benchmark/runBenchmarks.cjs --suite reducer",
    "benchmark:loop": "node scripts/benchmark/runBenchmarks.cjs --suite loop"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@playwright/test": "^1.61.0",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "^1.61.0",
    "prettier": "^3.8.4",
    "terser": "^5.48.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "immer": "^11.1.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "vite-plugin-singlefile": "^2.3.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
